# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 절대 커밋하지 않습니다 (.gitignore 에 등록돼 있습니다).
# ─────────────────────────────────────────────────────────────

# ── 기본 ──
PORT=8787
SKINLAB_SECRET=여기에-길고-무작위인-문자열                 # 토큰 서명 키. 운영에서 반드시 교체
ADMIN_TOKEN=관리자-대시보드-비밀번호

# ── 판매처 1. 네이버 쇼핑 검색 (가장 먼저 붙이세요 · 즉시 발급 · 하루 25,000회) ──
# developers.naver.com → 애플리케이션 등록 → 사용 API '검색' 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 판매처 2. 쿠팡 파트너스 (심사 필요 · 검색 API 는 1시간 10회 제한) ──
# 파트너스 로그인 → 상단 Tools → 파트너스 API
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_PARTNER_ID=                                      # 링크에 붙는 추적 ID (lptag)

# ── 판매처 3. Amazon (어소시에이트 가입 후 180일 내 판매 3건이 있어야 키가 열림) ──
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOC_TAG=
USD_KRW=1380                                             # 원화 환산 환율

# ── 판매처 4. 공개 API 가 없는 곳 (올리브영 등) ──
# 제휴 네트워크에서 받은 추적 ID. 상품/가격은 data/manual/<판매처>.csv 로 넣습니다.
OLIVEYOUNG_PARTNER_ID=
ELEVEN_PARTNER_ID=

# ── 제휴 전환 포스트백 (판매처가 '팔렸다'고 알려줄 때 쓰는 비밀번호) ──
AFFILIATE_POSTBACK_TOKEN=

# ── 결제 (mock / toss / stripe) ──
SKINLAB_PAYMENTS=mock
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI 닥터 대사 다듬기 (없어도 규칙 엔진으로 동작합니다) ──
ANTHROPIC_API_KEY=
