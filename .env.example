# ─────────────────────────────────────────────────────────────
#  ScalpDesk 설정 파일 (예시)
#
#  쓰는 법
#   1) 이 파일을 복사해 이름을 .env 로 바꿉니다 (앞의 점 포함)
#   2) 필요한 줄의 맨 앞 # 을 지우고 값을 넣습니다
#   3) 앱을 다시 실행하면 자동으로 읽힙니다
#
#  ⚠️ .env 는 비밀번호와 같습니다. 남에게 보내거나 캡처해 올리지 마세요.
#     (git 에는 올라가지 않도록 이미 제외해 두었습니다)
# ─────────────────────────────────────────────────────────────


# ── AI 추천 · Claude ────────────────────────────────────────
# console.anthropic.com 에서 발급받은 키 (sk-ant- 로 시작)
#ANTHROPIC_API_KEY=sk-ant-여기에_키를_붙여넣으세요


# ── AI 추천 · Llama (Meta) ──────────────────────────────────
# 내 컴퓨터에서 Ollama 로 돌리는 경우 (무료). 설치만 되어 있으면 자동 인식되어
# 아래 두 줄은 없어도 됩니다. 모델 이름을 바꾸고 싶을 때만 사용하세요.
#LLAMA_BASE_URL=http://localhost:11434/v1
#LLAMA_MODEL=llama3.1
#
# Llama API / Groq 등 외부 서비스를 쓰는 경우
#LLAMA_API_KEY=여기에_키
#LLAMA_BASE_URL=https://api.llama.com/compat/v1


# ── 한국 실시간 시세 (한국투자증권) ─────────────────────────
# apiportal.koreainvestment.com 에서 발급
#KIS_APP_KEY=여기에_앱키
#KIS_APP_SECRET=여기에_앱시크릿
#KIS_ACCOUNT=12345678-01
#
# 1 = 모의투자 (처음에는 반드시 1), 0 = 실전 계좌
#KIS_PAPER=1


# ── 기타 ────────────────────────────────────────────────────
# 5173 번이 이미 쓰이고 있을 때 다른 번호로
#PORT=5173
#
# 뉴스 수집을 끄려면 0
#NEWS_ENABLED=1
