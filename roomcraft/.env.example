# 클릭 게이트웨이가 공개될 주소. 영상 캡션에 들어가는 링크의 앞부분입니다.
PUBLIC_ORIGIN=https://roomcraft.world
PORT=8787

# 쿠팡 파트너스 오픈API — 반드시 서버에만 둡니다
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=

# 아마존 어소시에이트 추적 태그
AMAZON_ASSOCIATE_TAG=

# 세트 구성·카피 판단용. 없으면 휴리스틱으로 동작합니다(수익 계산은 동일)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

BUNDLE_SIZE=6
