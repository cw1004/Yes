# ============================================================
#  한국투자증권 KIS Open API 설정
#  1) 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
#  2) .env 는 절대 커밋하지 마세요 (.gitignore 에 등록되어 있습니다).
# ============================================================

# paper = 모의투자(기본), real = 실전투자
KIS_ENV=paper

# KIS 개발자센터(https://apiportal.koreainvestment.com)에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=

# 계좌번호 8자리 (CANO)
KIS_ACCOUNT_NO=
# 계좌상품코드 2자리 (ACNT_PRDT_CD). 종합계좌는 보통 01
KIS_ACCOUNT_PRODUCT_CODE=01

# --- 안전장치 -------------------------------------------------
# 실전투자 주문을 실제로 내보내려면 반드시 true 로 명시해야 합니다.
KIS_ALLOW_REAL_TRADING=false
# true 이면 주문 API 를 호출하지 않고 로그만 남깁니다(모의 체결).
KIS_DRY_RUN=true

# --- 리스크 한도 ----------------------------------------------
# 1회 주문 최대 금액(원)
KIS_MAX_ORDER_AMOUNT=1000000
# 종목당 최대 보유 금액(원)
KIS_MAX_POSITION_AMOUNT=3000000
# 하루 최대 주문 횟수
KIS_MAX_ORDERS_PER_DAY=50
# 하루 최대 손실 금액(원). 초과 시 자동으로 매매를 중단합니다.
KIS_MAX_DAILY_LOSS=300000
# 동시에 보유 가능한 종목 수
KIS_MAX_POSITIONS=5

# --- 대시보드(웹) ---------------------------------------------
# 접속 토큰. 비워두면 실행할 때마다 새로 만들어 터미널에 출력합니다.
KIS_WEB_TOKEN=
# 대시보드 관심 종목 (쉼표 구분)
KIS_WATCHLIST=005930,000660

# --- 저장 위치 ------------------------------------------------
KIS_DATA_DIR=./data
KIS_LOG_LEVEL=INFO
