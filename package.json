{
  "name": "skinlab-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkinLab AI - AI 닥터 상담형 피부 진단 / 전후 사진 비교 / 톤 맞춤 화장품 추천 / 커머스 랭킹 수익화 앱",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "simulate": "node scripts/simulate.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "catalog:status": "node scripts/sync-catalog.mjs --status",
    "catalog:check": "node scripts/sync-catalog.mjs --check",
    "setup:sim": "npm i -D playwright && npx playwright install chromium",
    "sim:verify": "node scripts/verify-personas.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  }
}
