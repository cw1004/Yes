export KIS_APP_KEY=""
export KIS_APP_SECRET=""
export KIS_ACCOUNT=""          # 계좌번호 앞 8자리
export KIS_PRODUCT_CODE="01"   # 상품코드 (보통 01)
# 응답 필드명이 다를 때 덮어쓸 명세 파일 (kis-probe 로 확인 후 작성)
