{
  "name": "roomcraft-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 인테리어 리모델링 & 쇼퍼블 공간 디자인 스튜디오",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test:api": "API_BASE=${API_BASE:-http://localhost:8787/api} node server/api.test.mjs",
    "test:e2e": "node smoke.mjs && node e2e-auth.mjs",
    "dev:all": "node -e \"console.log('터미널 두 개로: npm run server / npm run dev')\"",
    "start": "node server/index.js",
    "build:deploy": "npm run build && NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.6.2",
    "nodemailer": "^9.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  }
}
