# ─── AI 프로바이더 (서버 전용, 브라우저에 노출되지 않습니다) ───────────────
# 렌더링(Before -> After)에 사용
GEMINI_API_KEY=
# 디자이너 챗에 사용
ANTHROPIC_API_KEY=

RENDER_MODEL=gemini-2.5-flash-image
CHAT_MODEL=claude-opus-5

# ─── 결제 ────────────────────────────────────────────────────────────────
# 비워두면 dev 시뮬레이터로 동작합니다 (실제 청구 없음, 동일한 지급 경로).
STRIPE_SECRET_KEY=
# 웹훅 서명 검증용. 없으면 웹훅은 400 으로 거절됩니다 (무단 크레딧 지급 방지).
#   stripe listen --forward-to localhost:8787/api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# ─── 서버 ────────────────────────────────────────────────────────────────
PORT=8787
# CORS 허용 출처 + 결제 후 리디렉트 대상
APP_URL=http://localhost:5173
# SQLite 파일 위치 (기본: ./data/roomcraft.db)
DATABASE_PATH=
