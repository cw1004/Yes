# ─── AI 프로바이더 (서버 전용, 브라우저에 노출되지 않습니다) ───────────────
# 렌더링(Before -> After)에 사용
GEMINI_API_KEY=
# 디자이너 챗에 사용
ANTHROPIC_API_KEY=

RENDER_MODEL=gemini-2.5-flash-image
CHAT_MODEL=claude-opus-5

# ─── 결제 ────────────────────────────────────────────────────────────────
# 비워두면 dev 시뮬레이터로 동작합니다 (실제 청구 없음, 동일한 지급 경로).
STRIPE_SECRET_KEY=
# 웹훅 서명 검증용. 없으면 웹훅은 400 으로 거절됩니다 (무단 크레딧 지급 방지).
#   stripe listen --forward-to localhost:8787/api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# ─── 메일 (이메일 인증) ──────────────────────────────────────────────────
# 비워두면 인증 링크를 서버 콘솔에 출력하고, 개발 환경에서는 API 응답에도 실어 보냅니다.
# 운영에서는 반드시 설정하세요 — 없으면 사용자가 인증을 못 해 크레딧이 지급되지 않습니다.
#   예: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=RoomCraft <no-reply@example.com>

# ─── 레이트 리밋 ─────────────────────────────────────────────────────────
# 프록시(로드밸런서·CDN) 뒤에 있으면 신뢰할 홉 수를 지정하세요.
# 0(기본)이면 프록시 헤더를 무시합니다. 잘못 잡으면 전원이 한 덩어리로 묶이거나
# X-Forwarded-For 위조로 리밋이 우회됩니다.
TRUST_PROXY=0

# 저장소가 메모리라 서버를 재시작하면 카운터가 초기화됩니다.
RATE_LIMIT_GLOBAL_PER_15MIN=600
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_VERIFY_MAIL_PER_HOUR=3
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_RENDER_PER_HOUR=40
RATE_LIMIT_CHAT_PER_HOUR=120
RATE_LIMIT_LINK_PER_HOUR=120
RATE_LIMIT_CHECKOUT_PER_HOUR=20

# ─── 서버 ────────────────────────────────────────────────────────────────
PORT=8787
# CORS 허용 출처 + 결제 후 리디렉트 대상
APP_URL=http://localhost:5173
# 제휴 추적 링크(/r/:id)의 공개 주소. 비우면 APP_URL 을 씁니다.
# 웹과 API 를 다른 도메인에 배포한다면, /r 을 API 로 넘기는 쪽 도메인을 넣으세요.
LINK_BASE_URL=
# 클릭 방문자 해시에 섞는 솔트. 비우면 매 재시작마다 새로 생성됩니다
# (재시작 전후의 방문자 중복 판정이 끊어집니다).
CLICK_SALT=
# SQLite 파일 위치 (기본: ./data/roomcraft.db)
DATABASE_PATH=

# ── AI 제품 소싱 ────────────────────────────────────────────────────────
# 웹 검색으로 실제 판매 제품을 찾습니다. ANTHROPIC_API_KEY 를 함께 씁니다.
SOURCING_MODEL=claude-opus-5
# 캐시 수명(ms). 짧을수록 최신이지만 그만큼 요금이 나갑니다.
SOURCING_TTL_MS=21600000
# 배관만 시험할 때: stub (모델을 부르지 않습니다) / stub-fail (환불 경로 확인)
# SOURCING_PROVIDER=stub

# 제품 상품 컷 생성. GEMINI_API_KEY 를 함께 씁니다.
PRODUCT_IMAGE_MODEL=gemini-2.5-flash-image

RATE_LIMIT_SOURCING_PER_HOUR=20
RATE_LIMIT_IMAGE_PER_HOUR=30
