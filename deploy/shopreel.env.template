# /etc/shopreel/shopreel.env  —  systemd EnvironmentFile
#
# 주의: systemd 는 `export` 접두사를 지원하지 않습니다. KEY=VALUE 형식으로만 적으세요.
#       (셸에서 쓰던 shopreel.env 와 형식이 다릅니다)
# 이 파일은 비밀값을 담으므로 권한은 600, 소유자는 shopreel 이어야 합니다.

# ── 쿠팡 파트너스 ───────────────────────────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_ENDPOINT=bestcategories
COUPANG_CATEGORY_ID=1016
COUPANG_SUBID=shopreel

# ── 유튜브 (python3 -m tools.youtube_auth 로 발급) ───────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public
YOUTUBE_COMMENT=1
YOUTUBE_THUMBNAIL=1

# ── 인스타그램 ─────────────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_THUMB_OFFSET=2000
# 비우면 tracker_base + /v 를 사용합니다 (권장)
PUBLIC_VIDEO_BASE=

# ── 추적 서버 ──────────────────────────────────────────────
# 전환 웹훅 공유 비밀값 — 반드시 임의의 긴 문자열로 바꾸세요
SHOPREEL_POSTBACK_SECRET=
# 클릭 IP 해시 솔트 — 한 번 정하면 바꾸지 마세요
SHOPREEL_IP_SALT=

# ── 선택 ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
