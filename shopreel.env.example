# SHOPREEL 환경변수 예시 — 필요한 것만 채워서 `source shopreel.env` 로 사용
# 비밀값은 설정 파일이 아니라 환경변수로만 관리한다.

# ── 수집 소스 ────────────────────────────────────────────────
# AliExpress 제휴 오픈 API
export ALIEXPRESS_APP_KEY=
export ALIEXPRESS_APP_SECRET=
export ALIEXPRESS_TRACKING_ID=
export ALIEXPRESS_CATEGORY_IDS=
# Amazon Product Advertising API 5.0 + Associates
export AMAZON_ACCESS_KEY=
export AMAZON_SECRET_KEY=
export AMAZON_ASSOC_TAG=
export AMAZON_KEYWORDS="best sellers"
# 쿠팡 파트너스
export COUPANG_ACCESS_KEY=
export COUPANG_SECRET_KEY=
export COUPANG_PARTNERS_ID=
export COUPANG_CATEGORY_ID=1001
# 라쿠텐 이치바
export RAKUTEN_APP_ID=
export RAKUTEN_AFF_ID=
# eBay
export EBAY_CLIENT_ID=
export EBAY_CLIENT_SECRET=
export EBAY_EPN_CAMPAIGN=
# 직접 만든 수집기(JSON 엔드포인트)
export SHOPREEL_CUSTOM_URL=
export SHOPREEL_CUSTOM_HEADERS='{}'

# ── 업로드 ───────────────────────────────────────────────────
# refresh token 발급:  python3 -m tools.youtube_auth --save shopreel.env
export YOUTUBE_CLIENT_ID=
export YOUTUBE_CLIENT_SECRET=
export YOUTUBE_REFRESH_TOKEN=
export YOUTUBE_PRIVACY=public         # public | unlisted | private
export YOUTUBE_CATEGORY_ID=22
export YOUTUBE_PUBLISH_AT=            # 예약 발행 (RFC3339). 넣으면 비공개로 올라가 예약된다
export YOUTUBE_THUMBNAIL=1            # 0 이면 썸네일 업로드 생략 (채널 미인증 시)
export YOUTUBE_COMMENT=1              # 0 이면 상품 링크 댓글 생략
export TIKTOK_ACCESS_TOKEN=
export TIKTOK_DIRECT_POST=            # 1 이면 바로 게시(심사 통과 앱만)
export IG_USER_ID=
export IG_ACCESS_TOKEN=
export IG_THUMB_OFFSET=2000           # 커버로 쓸 지점(ms)
export IG_SHARE_TO_FEED=1             # 0 이면 릴스 탭에만 노출
# 비우면 추적 서버의 /v 를 쓴다 (tracker_base 가 공개 도메인이어야 함)
export PUBLIC_VIDEO_BASE=
export FB_PAGE_ID=
export FB_PAGE_TOKEN=

# ── 대본/음성 ────────────────────────────────────────────────
export ANTHROPIC_API_KEY=             # 있으면 --script llm 사용 가능
export ELEVENLABS_API_KEY=
export ELEVENLABS_VOICE_ID=

# ── 추적 서버 ────────────────────────────────────────────────
export SHOPREEL_POSTBACK_SECRET=      # 전환 웹훅 공유 비밀값
export SHOPREEL_IP_SALT=              # 클릭 IP 해시 솔트
