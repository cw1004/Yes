# 스캘퍼 환경변수 — 이 파일을 복사해서 쓰세요:  cp scalper/.env.example .env && source .env
# 하나도 없어도 시뮬레이션 모드로 전부 동작합니다.

# ── 시세 + 주문 (미국주식 수수료 무료) ──
export ALPACA_API_KEY=""
export ALPACA_API_SECRET=""

# ── 뉴스 (없으면 Yahoo/Nasdaq RSS 로 폴백) ──
export FINNHUB_API_KEY=""
export MARKETAUX_API_KEY=""

# ── 안전장치 ──
# 실계좌 주문을 열려면 이 값을 1 로. --live-account 플래그와 둘 다 있어야 열립니다.
export SCALPER_ALLOW_LIVE=""
# 외부 호출을 아예 막고 싶을 때 1
export SCALPER_OFFLINE=""

# 거시 데이터(FRED)·시장지수(Stooq)는 키가 필요 없습니다.
